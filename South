    <!-- Script JavaScript para o Simulador -->
    <script>
        function calcularLucro() {
            const select = document.getElementById('planSelect');
            const valores = select.value.split('|');
            const capital = parseFloat(valores[0]);
            const percentagem = parseFloat(valores[1]);
            
            const total = capital + (capital * (percentagem / 100));
            
            document.getElementById('resultadoSimulacao').innerText = 'R' + total.toLocaleString('en-US');
        }
        calcularLucro();
    </script>

